rules_version = '2';

// Regras do Firebase Storage
service firebase.storage {
  match /b/{bucket}/o {
    
    // Regra para a pasta startups_images e outros arquivos
    match /{allPaths=**} {
      // Garante que a requisição venha de um usuário com um token válido e autenticado
      allow read: if request.auth != null && request.auth.token != null && request.auth.uid != null;
      
      // Para escrita, também garante que o token é válido
      allow write: if request.auth != null && request.auth.token != null && request.auth.uid != null;
    }
  }
}
